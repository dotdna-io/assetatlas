# Claude Code settings (user-specific) — but SHARE the path-scoped rule files.
# Must exclude the CONTENTS (.claude/*), not the directory: git cannot re-include
# anything under a directory that is itself excluded, so a bare `.claude/` would
# make the `!` below a no-op.
.claude/*
!.claude/rules/
# Embedding models cache (downloaded on first run)
models/cache/
# LLM models for llama.cpp (downloaded separately)
docker/llm-server/models/
*.gguf

