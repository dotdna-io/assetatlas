# AssetAtlas Backend API - Environment Configuration Template
#
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)
#
# Quick start:
#   cp .env.example .env
#   # Edit .env with your values
#   ./scripts/start.sh     # Start the full stack (API, UI, scheduler, MCP)

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Database password — used by deploy/compose/docker-compose.yml to seed Postgres and to
# build DATABASE_URL for the API/scheduler/MCP services. REQUIRED.
DB_PASSWORD=

# Database Connection (REQUIRED)
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://assetatlas:YOUR_PASSWORD_HERE@localhost:5434/assetatlas

# Flask Secret Key (REQUIRED — no default, app refuses to start without it)
# Generate with: openssl rand -hex 32
SECRET_KEY=

# JWT signing key (REQUIRED — no default). Use a value distinct from
# SECRET_KEY so a leak of one doesn't compromise both.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# pgadmin login (only used when running the optional pgadmin compose profile)
PGADMIN_PASSWORD=

# Integration credential encryption key (REQUIRED — no default)
# Used to encrypt/decrypt MFA secrets, LDAP/OIDC/SMTP passwords, backup-code HMAC keys.
# Format: Fernet key (32 raw bytes, urlsafe-base64 = 44 chars)
# Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# OR (no python required):
#   openssl rand 32 | base64 | tr '+/' '-_'
# IMPORTANT: this key is set-once. Rotating it invalidates all existing
# encrypted credentials and locks out MFA users — they would need to
# re-enroll, and integration passwords would need to be re-saved.
ASSETATLAS_ENCRYPTION_KEY=

# CORS Origins (REQUIRED for production)
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Number of trusted reverse-proxy hops in front of the API (X-Forwarded-* trust).
# Counts every reverse proxy that adds an X-Forwarded-For entry between the
# real client and Flask. Wraps werkzeug.middleware.proxy_fix.ProxyFix so
# request.remote_addr reflects the real client IP for rate-limiting and
# audit logging.
#
# Common topologies:
#   0  Direct exposure, no proxy in front (dev / single-container test)
#   1  Single nginx in front of the API (Docker compose, online installer)
#   2  Two-hop nginx (e.g. host nginx → container nginx → API; common in
#      air-gapped or path-prefixed deployments)
#   N  Add 1 for every additional trusted proxy
#
# WARNING: setting this too high lets a client spoof X-Forwarded-For headers,
# which would corrupt audit-log IPs and let a single attacker DoS per-IP rate
# limits for everyone. Only count proxies you control.
TRUSTED_PROXY_HOPS=0

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Flask Environment
# Options: development, production, test
FLASK_ENV=development

# ============================================================================
# SCHEDULER CONFIGURATION
# ============================================================================

# Scheduler Mode (Controls how scheduled integrations run)
# Options:
#   - disabled  : Scheduler completely disabled (migrations, maintenance)
#   - embedded  : Scheduler runs in web process (DEVELOPMENT ONLY)
#   - worker    : Dedicated scheduler worker (PRODUCTION - separate container)
#
# Development: embedded
# Production Web Containers: disabled
# Production Scheduler Container: worker
SCHEDULER_MODE=embedded

# ============================================================================
# DATABASE CONNECTION POOLING
# ============================================================================

# Connection Pool Size (number of connections to maintain)
# Development: 5-10
# Production: 20-50 (depends on load)
DB_POOL_SIZE=20

# Maximum Overflow (additional connections beyond pool size)
# Development: 5
# Production: 10-20
DB_MAX_OVERFLOW=10

# Pool Timeout (seconds to wait for available connection)
# Default: 30 seconds
DB_POOL_TIMEOUT=30

# Pool Recycle (seconds before recycling connections)
# Default: 3600 (1 hour) - prevents stale connections
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS CACHE
# ============================================================================

# Redis Connection URL
# Format: redis://host:port/database_number
# Development: redis://localhost:6379/0
# Docker: redis://redis:6379/0
# Production: redis://your-redis-host:6379/0
REDIS_URL=redis://localhost:6379/0

# Cache Type
# Options: redis, simple (in-memory), null (disabled)
# Development: redis
# Production: redis
# Testing: simple (set automatically in tests)
CACHE_TYPE=redis

# Cache Default Timeout (seconds)
# How long cached data is valid before expiring
# Connector discovery: 300 (5 minutes)
# Dashboard aggregations: 60 (1 minute)
CACHE_DEFAULT_TIMEOUT=300

# ============================================================================
# LOGGING
# ============================================================================

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: DEBUG
# Production: WARNING
LOG_LEVEL=INFO

# Log Directory (for containerized deployments)
LOG_DIR=logs

# ============================================================================
# LOG RETENTION (APScheduler Maintenance Job)
# ============================================================================

# Enable automatic log cleanup and archival
LOG_RETENTION_ENABLED=true

# Cron schedule for log cleanup (default: 3:00 AM UTC daily)
# Format: minute hour day-of-month month day-of-week
LOG_RETENTION_CRON=0 3 * * *

# ============================================================================
# API SETTINGS
# ============================================================================

# Tag Rules Auto-Execution
# Automatically execute tag assignment rules when created
# Options: true, false
TAG_RULES_AUTO_EXECUTE=true

# Pagination Defaults
# Default page size for list endpoints
DEFAULT_PAGE_SIZE=50

# Maximum page size (prevents abuse)
MAX_PAGE_SIZE=200

# ============================================================================
# VERSION METADATA (auto-set during Docker build — no need to set manually)
# ============================================================================

# Application version (reads from VERSION file if not set)
# APP_VERSION=2026.02.1

# Build timestamp (set automatically by deploy scripts)
# BUILD_DATE=2026-02-21T12:00:00Z

# Git commit hash (set automatically by deploy scripts)
# GIT_COMMIT=abc1234

# ============================================================================
# TESTING
# ============================================================================

# Test Database URL (for running tests)
# Should be a separate database from production/development
# Will be dropped and recreated during tests
TEST_DATABASE_URL=postgresql://assetatlas:YOUR_PASSWORD_HERE@localhost:5434/assetatlas_test

# ============================================================================
# DOCKER / DOCKER COMPOSE SETTINGS
# ============================================================================

# Docker Compose Database Password
DB_PASSWORD=your-secure-password-here

# PostgreSQL Settings (for TimescaleDB container)
POSTGRES_USER=assetatlas
POSTGRES_DB=assetatlas

# pgAdmin Configuration (optional - for database management UI)
PGADMIN_EMAIL=admin@assetatlas.local
PGADMIN_PASSWORD=admin-password-here

# TimescaleDB Tuning (optional - advanced settings)
# TS_TUNE_MAX_CONNS=100
# TS_TUNE_MAX_BG_WORKERS=8
# TS_TUNE_NUM_CPUS=2
# TS_TUNE_MEMORY=4GB

# ============================================================================
# EMBEDDING SYSTEM (optional — powers semantic search suggestions)
# ============================================================================

# Auto-update embeddings after pipeline runs (detect new fields, generate descriptions)
EMBEDDING_AUTO_UPDATE=true

# Max time for embedding update step in pipeline (seconds)
EMBEDDING_UPDATE_TIMEOUT=120

# LLM output ceiling for AI-generated field descriptions + synonyms. Sized for
# reasoning models (e.g. Qwen3) that "think" before answering — a small cap is
# consumed mid-reasoning and yields empty descriptions. It's a ceiling, not a
# target: the prompt keeps descriptions to 1-2 sentences. (default 4096)
EMBEDDING_LLM_MAX_TOKENS=4096

# Wall-clock ceiling (seconds) for a single AI description/synonym LLM request.
# Guards against a hung or pathologically-slow provider (EMBEDDING_LLM_MAX_TOKENS
# bounds output length; this bounds time). Applied per field. (default 120)
EMBEDDING_LLM_REQUEST_TIMEOUT=120

# ============================================================================
# CHAT ASSISTANT (optional — conversational UI over AssetAtlas data)
# ============================================================================

CHAT_ENABLED=true
# Provider/model/api-key/base-url/prompt-cache/thinking-enabled live in the
# chat_providers DB table per issue #636. Configure each provider under
# Settings → Chatbot in the admin UI.
CHAT_MAX_MESSAGES_PER_USER_PER_DAY=200
CHAT_MAX_TOOL_ITERATIONS=10
CHAT_TURN_TIMEOUT_SECONDS=60
CHAT_MAX_INPUT_TOKENS=100000
# Per-turn output ceiling. Reasoning models (e.g. Qwen3) spend tokens "thinking"
# before the answer, so a small cap truncates mid-reasoning (empty/cut-off replies).
CHAT_MAX_OUTPUT_TOKENS=8192
CHAT_RETENTION_DAYS=90

# ============================================================================
# NOTES
# ============================================================================
#
# Development Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Update DATABASE_URL with your local PostgreSQL credentials
#   3. Start Redis: docker run -d -p 6379:6379 redis:7-alpine
#      OR use docker-compose: docker-compose up -d redis
#   4. Generate SECRET_KEY: openssl rand -hex 32
#   5. Set SCHEDULER_MODE=embedded (for development)
#   6. Start the stack: ./scripts/start.sh
#
# Production Deployment:
#   - Use separate .env files for staging/production
#   - Store secrets in secure vault (AWS Secrets Manager, HashiCorp Vault, etc.)
#   - Set SCHEDULER_MODE=disabled in web containers
#   - Run dedicated scheduler container with SCHEDULER_MODE=worker
#   - Use strong, randomly generated SECRET_KEY
#   - Restrict CORS_ORIGINS to your actual domains
#
# Docker Deployment:
#   - See deploy/installer/install.sh for the install/update flow
#   - Use deploy/compose/docker-compose.yml for orchestration
#   - Set environment variables via docker-compose or .env file
#
# Security Best Practices:
#   - NEVER commit .env to version control
#   - Use strong, unique passwords for DATABASE_URL
#   - Rotate SECRET_KEY periodically in production
#   - Limit CORS_ORIGINS to trusted domains only
#   - Use read-only database credentials where possible

# =============================================================================
# Monitoring overlay (opt-in, Sub-project A of epic #487)
# =============================================================================
# When MONITORING_ENABLED=true, the docker-compose.monitoring.yml overlay is
# expected to be active. Alertmanager authenticates to the webhook with this
# shared secret via an `Authorization: Bearer` header.
MONITORING_ENABLED=false
ALERTMANAGER_WEBHOOK_SECRET=
# Where Prometheus rule YAML files live (boot-time sync reads these into alert_rules).
MONITORING_RULES_DIR=monitoring/alerts
# Prometheus TSDB retention (passed through to the prometheus container).
PROMETHEUS_RETENTION=15d
# URL to the Prometheus HTTP API (used by /api/monitoring/query proxy).
# When running the monitoring overlay alongside the main stack, this is the
# Docker service name. Override for split deployments.
PROMETHEUS_URL=http://prometheus:9090

# === Microsoft Teams bot (optional) ===
# Required only if you run with --profile teams.
# - TEAMS_BOT_APP_ID/PASSWORD/TENANT_ID come from your Azure Bot resource.
# - ASSETATLAS_BRIDGE_API_KEY is generated by install.sh; it gates the
#   /api/auth/teams-link/* and /api/auth/teams-bridge/* endpoints.
# - TEAMS_LINK_SECRET_KEY signs the link-token JWT; install.sh generates it.
# - ASSETATLAS_PUBLIC_BASE_URL is the BOOTSTRAP fallback for the public
#   AssetAtlas URL. The operational source of truth is the
#   security.public_base_url setting in System -> Security (DB-stored,
#   hot-reloadable). This env var only kicks in when the DB row is empty,
#   so first-boot installs work before an operator visits the Settings UI.
#   It is read by:
#     - email link generation (password reset / invite / welcome)
#     - Teams link tokens
#     - Teams app manifest (websiteUrl/privacyUrl/termsOfUseUrl)
#     - Teams messaging endpoint computation
# - TEAMS_DEVELOPER_URL is the manifest's developer-block URL
#   (websiteUrl, privacyUrl, termsOfUseUrl). Teams REQUIRES HTTPS here.
#   Defaults to the resolved public_base_url when that's https://; for
#   local-dev (http://localhost) you must set this explicitly so the
#   Teams sideload validation passes.
# - ASSETATLAS_API_URL is how the bridge process reaches the API.
#   Default http://api:5001 assumes Docker-Compose service-name
#   resolution. Override to http://localhost:5001 when running the
#   bridge as a local Python process (`python -m src.teams_bridge`).
# - ORG_NAME goes into the manifest's developer.name.
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_BOT_APP_TENANT_ID=
ASSETATLAS_BRIDGE_API_KEY=
TEAMS_LINK_SECRET_KEY=
ASSETATLAS_PUBLIC_BASE_URL=https://localhost
TEAMS_DEVELOPER_URL=
ASSETATLAS_API_URL=http://api:5001
ORG_NAME=

# =============================================================================
# Reference data updates (optional)
# =============================================================================
# Settings -> Data -> Reference Data -> "Check for updates" inspects this
# GitHub repo's Releases for MAC-vendor / OS-EOL bundle updates. The code
# default is a non-existent placeholder ("<your-org>/...") so a misconfigured
# fork fails loudly instead of silently pulling someone else's bundles —
# which means the button returns "upstream unavailable" until this is set.
# First-party installs use the canonical bundle repo below; forks: set your own.
REFERENCE_BUNDLE_REPO=dotdna-io/assetatlas-reference-bundles
